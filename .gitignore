# Project data and secrets (configs contain API keys / tokens)
config*.json
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.log
user_data/*
docker-compose-*.yml
# FreqUI build downloaded by `freqtrade install-ui`
freqtrade/rpc/api_server/ui/*

# Python build artefacts
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Tests, coverage and tool caches
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.*_cache/

# Environments and editors
.env
.venv
.python-version
.idea
.vscode
.DS_Store
*.ipynb_checkpoints

# AI agents (local files only)
*.local.md
.claude/*.local.json
.claude/**/*.log

# Exceptions
!*.gitkeep
!tests/testdata/config_full.example.json
