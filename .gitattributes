# Line ending policy (checked by scripts/check_encoding.py):
# - every text file: UTF-8 without BOM, LF line endings
# - Windows scripts: CRLF in the working tree (Windows PowerShell 5.1 / cmd expect it)
# The repository always stores LF; eol= controls what is written on checkout,
# regardless of the local core.autocrlf setting.
*           text=auto eol=lf
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary data used by tests and the bundled web UI
*.feather   binary
*.parquet   binary
*.pickle    binary
*.gz        binary
*.zip       binary
*.ico       binary
*.png       binary
*.jpg       binary
*.whl       binary
