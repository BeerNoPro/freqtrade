{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(.venv/Scripts/freqtrade.exe:*)",
      "Bash(.venv/Scripts/pytest.exe:*)",
      "Bash(.venv/Scripts/ruff.exe:*)",
      "Bash(.venv/Scripts/mypy.exe:*)",
      "Bash(./.venv/Scripts/python.exe:*)",
      "Bash(./.venv/Scripts/freqtrade.exe:*)",
      "PowerShell(.venv/Scripts/python.exe:*)",
      "PowerShell(.venv/Scripts/freqtrade.exe:*)",
      "PowerShell(.venv/Scripts/pytest.exe:*)",
      "PowerShell(.venv/Scripts/ruff.exe:*)",
      "PowerShell(.venv/Scripts/mypy.exe:*)",
      "PowerShell(.\\.venv\\Scripts\\python.exe:*)",
      "PowerShell(.\\.venv\\Scripts\\freqtrade.exe:*)",
      "PowerShell(.\\.venv\\Scripts\\pytest.exe:*)",
      "PowerShell(.\\.venv\\Scripts\\ruff.exe:*)",
      "PowerShell(.\\.venv\\Scripts\\mypy.exe:*)",
      "PowerShell(.\\run.ps1:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(sort:*)",
      "Bash(mkdir:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git remote:*)",
      "Bash(git stash list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(uv:*)",
      "Bash(freqtrade:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pre-commit:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(python:*)",
      "PowerShell(py:*)",
      "PowerShell(pip:*)",
      "PowerShell(uv:*)",
      "PowerShell(freqtrade:*)",
      "PowerShell(pytest:*)",
      "PowerShell(ruff:*)",
      "PowerShell(mypy:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Bash(find:* -delete)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(del:*)",
      "PowerShell(Clear-Content:*)",
      "PowerShell(rm:*)",
      "PowerShell(ri:*)",
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_fix.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
