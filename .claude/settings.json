{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "PowerShell(git push:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",
      "PowerShell(Remove-Item -Recurse:*)"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "WebSearch",
      "WebFetch",
      "Bash(cd:*)",
      "Bash(git:*)",
      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(.venv/Scripts/freqtrade.exe:*)",
      "Bash(.venv/Scripts/pytest.exe:*)",
      "Bash(.venv/Scripts/ruff.exe:*)",
      "Bash(.venv/Scripts/mypy.exe:*)",
      "Bash(./.venv/Scripts/python.exe:*)",
      "Bash(./.venv/Scripts/freqtrade.exe:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(uv:*)",
      "Bash(freqtrade:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pre-commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(xargs:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(test:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(rm:*)",
      "Bash(export:*)",
      "PowerShell(git:*)",
      "PowerShell(.venv/Scripts/python.exe:*)",
      "PowerShell(.venv/Scripts/freqtrade.exe:*)",
      "PowerShell(.venv/Scripts/pytest.exe:*)",
      "PowerShell(.venv/Scripts/ruff.exe:*)",
      "PowerShell(.venv/Scripts/mypy.exe:*)",
      "PowerShell(.\\.venv\\Scripts\\python.exe:*)",
      "PowerShell(.\\.venv\\Scripts\\freqtrade.exe:*)",
      "PowerShell(.\\.venv\\Scripts\\pytest.exe:*)",
      "PowerShell(.\\.venv\\Scripts\\ruff.exe:*)",
      "PowerShell(.\\.venv\\Scripts\\mypy.exe:*)",
      "PowerShell(.\\run.ps1:*)",
      "PowerShell(python:*)",
      "PowerShell(py:*)",
      "PowerShell(uv:*)",
      "PowerShell(freqtrade:*)",
      "PowerShell(pytest:*)",
      "PowerShell(ruff:*)",
      "PowerShell(mypy:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(Select-String:*)",
      "PowerShell(New-Item:*)",
      "PowerShell(Copy-Item:*)",
      "PowerShell(Move-Item:*)",
      "PowerShell(Remove-Item:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_fix.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
